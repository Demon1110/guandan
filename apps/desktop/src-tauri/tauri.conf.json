{
  "productName": "掼蛋",
  "version": "0.1.0",
  "identifier": "com.guandan.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "掼蛋",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
